ZSH=$HOME/.oh-my-zsh

ZSH_THEME="thomas"

plugins=(
  git
  shrink-path
  zsh-autosuggestions
)

source $HOME/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

source $ZSH/oh-my-zsh.sh

setopt AUTO_PARAM_SLASH

[[ -s "$HOME/.rvm/scripts/rvm" ]] && source "$HOME/.rvm/scripts/rvm"

command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi

if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi
eval "$($HOME/.local/bin/mise activate zsh)"


alias 'git stash poop'='echo 💩'
alias random-string='openssl rand -base64 30 | sed "s#/##"'
alias gs='git status'
alias gd='git diff'
alias gl='glog'
alias gco='git checkout'
alias gc='git commit'
alias gp='git push'
alias cat='bat --style=plain --pager=never'
alias glog='git log --pretty=format:"%C(yellow)%h%Creset %C(blue)%d%Creset %s — %C(blue)%ad %an%Creset" --graph --date=short'
alias meeting='uv run $HOME/projects/meeting/meeting.py'

[[ -f ~/.config/zsh/secrets.zsh ]] && source ~/.config/zsh/secrets.zsh

export ANDROID_HOME="$HOME/Library/Android/sdk"
export PYENV_ROOT="$HOME/.pyenv"

export PATH="/Users/thomas/anaconda/bin:$PATH"
export PATH="/usr/local/sbin:$PATH"
export PATH="$HOME/src:$PATH"
export PATH=$HOME/bin:/usr/local/bin:$PATH
export PATH="/opt/homebrew/opt:$PATH"
export PATH="/opt/homebrew/sbin:$PATH"
export PATH="/opt/homebrew/opt/crowdin@4/bin:$PATH"
export PATH="$HOME/scripts:$PATH"
export PATH="$HOME/.mint/bin:$PATH"
export PATH="$PATH:$HOME/.rvm/bin"
export PATH="$PATH:$HOME/scripts"
export PATH="$PYENV_ROOT/bin:$PATH"
export PATH="$HOME/.bin:$PATH"
export PATH="$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools"

export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
export COCOAPODS_DISABLE_STATS='true'
export FASTLANE_SKIP_UPDATE_CHECK='true'
export GPG_TTY="tty"

export GOPATH="$HOME/go"
export GOPRIVATE="github.com/viki-org/*"

export USE_GKE_GCLOUD_AUTH_PLUGIN=True

export DO_NOT_TRACK=true

tmux() {
  if [ "$#" -eq 0 ]; then
    command tmux new-session -A -s code
  else
    command tmux "$@"
  fi
}