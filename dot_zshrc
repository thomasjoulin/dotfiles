zmodload zsh/zprof

ZSH=$HOME/.oh-my-zsh

ZSH_THEME="thomas"

plugins=(
  git
  shrink-path
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

setopt AUTO_PARAM_SLASH

DISABLE_AUTO_TITLE="true"

function set_terminal_title() {
  echo -en "\e]2;$@\a"
}

[[ -s "$HOME/.rvm/scripts/rvm" ]] && . "$HOME/.rvm/scripts/rvm"  # This loads RVM 

if [ -f '/Users/thomas/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/thomas/google-cloud-sdk/path.zsh.inc'; fi

# Aliases

alias ponyd-start="ponyd serve --listen-interface=127.0.0.1"
alias pdstart="ponyd-start"
alias git-retag="sh ~/src/git-retag.sh"
alias git-tag-rename="sh ~/src/git-tag-rename.sh"
alias woff2otf="sh ~/src/woff2otf/woff2otf.py"
alias sayhi="sh ~/src/myscript.sh"
alias tun="ssh -D 8080 -C -N thomas@morgankorchia.com"
alias git-squash="git stash save ; git rebase -i HEAD~2 ; git stash pop"
alias 'git stash poop'='echo 💩'
alias random-string='openssl rand -base64 30 | sed "s#/##"'
alias gs='git status'
alias gd='git diff'
alias gl='glog'
alias gco='git checkout'
alias gc='git commit'
alias gp='git push'
alias cat='bat --style=plain --pager=never'
alias glog='git log --pretty=format:"%C(yellow)%h%Creset %C(blue)%d%Creset %s — %C(blue)%ad %an%Creset" --graph --date=short'
alias claude="/Users/thomas/.claude/local/claude"
alias viki="uvx -q --from ~/projects/viki viki"

# Environment variables

[[ -f ~/.config/zsh/secrets.zsh ]] && source ~/.config/zsh/secrets.zsh

export EDITOR="emacs"

export ANDROID_HOME="$HOME/Library/Android/sdk"
export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"

export PATH="/usr/local/sbin:$PATH"
export PATH="/opt/homebrew/bin:$PATH"
export PATH=$HOME/bin:/usr/local/bin:$PATH
export PATH="$ANDROID_HOME/tools:$ANDROID_HOME/tools/bin:$ANDROID_HOME/platform-tools:$PATH"
export PATH="$PATH:$HOME/.rvm/bin"
export PATH="$HOME/.bin:$PATH"
export PATH="/Users/thomas/scripts:$PATH"
export PATH="/Users/thomas/projects/xcutils:$PATH"
export PATH="/opt/homebrew/sbin:$PATH"
export PATH="/Users/thomas/src:$PATH"
export PATH="/Users/thomas/.claude/local:$PATH"
export PATH="/Users/thomas/.cargo/bin:$PATH"
export PATH="/Users/thomas/.local/bin:$PATH"
export PATH="$GOPATH/bin:$PATH"
export PATH="$HOME/.mint/bin:$PATH"

export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"

export ANDROID_HOME=/Users/thomas/Library/Android/sdk
export COCOAPODS_DISABLE_STATS='true'
export FASTLANE_SKIP_UPDATE_CHECK='true'
export GPG_TTY="tty"

export HOMEBREW_NO_AUTO_UPDATE=1

export HOMEBREW_NO_AUTO_UPDATE=1

export ENV=development
export FLAVOUR=google_qa

export GOPATH="$HOME/go"
export GOPRIVATE="github.com/viki-org/*"

export DO_NOT_TRACK=true

export USE_GKE_GCLOUD_AUTH_PLUGIN=True

eval "$(pyenv init -)"

tmux() {
  if [ "$#" -eq 0 ]; then
    command tmux new-session -A -s code
  else
    command tmux "$@"
  fi
}
